# Public browser-safe values
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_ADMIN_APP_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only integrations
STREETPLATE_API_URL=
SENTRY_DSN=
TURNSTILE_SECRET=
# Local only. In Production, set this to streetplate.co.za with no localhost entries.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,streetplate.co.za

# Optional staging-only browser test credentials. Use a dedicated customer;
# never commit real values.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_DRIVER_EMAIL=
E2E_DRIVER_PASSWORD=

# PayFast signing, Maps proxy, Cloudinary and the Supabase service role remain
# owned by the existing Express backend. Do not copy those secrets here.
