# Public browser-safe values
# Production must use https://www.streetplate.co.za (or the canonical HTTPS
# hostname). Local HTTP is supported only for localhost development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_ADMIN_APP_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only integrations
# Never prefix server secrets with NEXT_PUBLIC_. Values in this section must
# be configured only in the server/deployment environment.
STREETPLATE_API_URL=
SENTRY_DSN=
TURNSTILE_SECRET=
# Local only. In Production, set this to streetplate.co.za with no localhost entries.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,streetplate.co.za

# Shared Upstash Redis rate limiter. Vercel Marketplace injects these into
# Preview and Production. Leave them blank for the bounded localhost fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional logical partition; use a different value for each deployment tier.
RATE_LIMIT_NAMESPACE=

# Optional staging-only browser test credentials. Use dedicated synthetic
# accounts for each role; never commit real values.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_VENDOR_EMAIL=
E2E_VENDOR_PASSWORD=
E2E_DRIVER_EMAIL=
E2E_DRIVER_PASSWORD=

# PayFast signing, Maps proxy, Cloudinary and the Supabase service role remain
# owned by the existing Express backend. Do not copy those secrets here or
# expose them through a NEXT_PUBLIC_ variable.
